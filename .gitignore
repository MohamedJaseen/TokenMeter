# ---- secrets / credentials (NEVER commit real values) ---------------------
# These patterns apply recursively to every module in this repository.
.env
.env.*
*.env
!.env.example
application-local.yml
application-local.properties
application-secret.yml
application-secret.properties
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
service-account.json

# Keep real values for METERING_API_KEY, GEMINI_API_KEY, JWT_SECRET,
# database/Redis passwords, tenant keys, and cloud credentials in ignored
# environment or secrets files.  Git ignore rules cannot detect file content;
# scan staged changes for accidentally pasted secrets before committing.

# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Java / Maven ---------------------------------------------------------
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
surefire-reports/

# ---- Node -----------------------------------------------------------------
node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- IDEs / editors / OS --------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.settings/
.classpath
.project
.DS_Store
Thumbs.db
Desktop.ini

# ---- opencode / session scratch (local only) ------------------------------
.opencode/
opencode.json
*.smoke*.py
.smoke*.py
.fix_*.py
.test_*.py
_sdk_resolve.py
make_reset.py
run_smoke.py
smoke_final.py
